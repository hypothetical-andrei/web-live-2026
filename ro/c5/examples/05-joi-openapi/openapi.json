{
  "openapi": "3.1.1",
  "info": {
    "title": "Demonstrarea datelor unei sarcini",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/tasks": {
      "post": {
        "operationId": "createTask",
        "summary": "Validează titlul unei sarcini; demonstrația nu îl stochează.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Nevid; spațiile de la capete sunt eliminate."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creat",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["id", "title"],
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "JSON sau titlu invalid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": ["code"],
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Corp prea mare",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": ["code"],
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Tip media neacceptat",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": ["code"],
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Eroare internă",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": ["code"],
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
